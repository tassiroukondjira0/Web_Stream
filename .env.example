# Base de données PostgreSQL
# Fonctionne avec n'importe quel PostgreSQL : Neon, Supabase, Railway, ou un
# serveur local. Prisma se connecte en TCP via le provider standard
# `postgresql` — aucun pilote spécifique à un fournisseur n'est requis.
#
# Utilisez l'URL POOLÉE en production (serverless = nombreuses connexions
# courtes). Chez Neon, c'est l'option « Pooled connection » du dashboard.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ⚠️ Active les requêtes PostgreSQL. Tant que la valeur n'est pas exactement "true",
# `src/lib/catalog.ts` ne renvoie aucun contenu local (pas de catalogue de démo).
# Mettre "true" uniquement une fois le schéma appliqué (npx prisma db push).
DATABASE_READY="false"

# Authentification (JWT maison via jose)
# Générer un secret fort et unique : openssl rand -base64 32
NEXTAUTH_SECRET=""

# ─── TMDB (métadonnées légales : titres, synopsis, affiches, genres) ──────────
# Créez un compte sur https://www.themoviedb.org/settings/api
#
# TMDB_API_TOKEN  → "API Read Access Token" (v4, recommandé) — commence par "eyJ..."
# TMDB_API_KEY    → "API Key" (v3, alternative) — chaîne de 32 caractères
#
# ⚠️ TMDB ne fournit QUE des métadonnées (pas les fichiers vidéo). Les fiches
# importées sont créées en brouillon ; ajoutez une vidéo licenciée avant publication.
# Renseignez-en UN SEUL (le token v4 est prioritaire s'il est défini).
TMDB_API_TOKEN=""
TMDB_API_KEY=""

# Application
NEXT_PUBLIC_APP_NAME="CinéMax"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── PayDunya (Paiements Premium) ──────────────────────────────────────────
# Clés : https://paydunya.com → Integration API → votre application (AppDunya)
#   - master_key  : PAYDUNYA-MASTER-KEY
#   - private_key : PAYDUNYA-PRIVATE-KEY
#   - token       : PAYDUNYA-TOKEN
# Webhook (IPN) à déclarer : https://<votre-domaine>/api/payment/webhook
# mode "test" (sandbox) tant que le compte n'est pas activé, puis "live".
PAYDUNYA_MODE="test"
PAYDUNYA_CURRENCY="XOF"
# Canaux affichés au guichet (laisser vide = tous les moyens activés du compte)
# Ex. "card,orange-money-senegal,wave-senegal"
PAYDUNYA_CHANNELS=""
PAYDUNYA_STORE_NAME="CinéMax"

# ─── Fournisseurs externes (hébergeurs : uqload, voe, luluvido…) ─────────────
# Domaines du fournisseur partenaire (séparés par des virgules, essayés dans
# l'ordre). Surchargez pour suivre les changements de domaine du fournisseur
# sans redéployer. Vide = fournisseur inactif (seuls nos lecteurs hébergés
# Vidzy TMDB sont proposés sur les fiches).
PARTNER_DOMAINS=""

# ─── PayPal (Paiements Premium — Maroc & France) ──────────────────────────────
# Créez un compte Business sur https://www.paypal.com/bizsignup
# Puis une app sur https://developer.paypal.com → My Apps & Credentials
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# "sandbox" pour les tests, "live" en production
PAYPAL_MODE="sandbox"
# Webhook ID (optionnel, pour vérifier la signature) — dashboard PayPal → Webhooks
PAYPAL_WEBHOOK_ID=""

# Domaines FrenchManga (mangas/animés), même principe. Vide = défaut.
MANGA_DOMAINS=""

# Secret dedie au proxy d embeds (signature des URL inconnues)
EMBED_PROXY_SECRET=""
