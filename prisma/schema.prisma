generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUBSCRIBER
  ADMIN
}

enum MediaType {
  MOVIE
  SERIES
}

enum AccessLevel {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  country       String?        // Code pays ISO 3166-1 alpha-2 (ex: SN, CI, CM) — sert à filtrer les moyens de paiement PayDunya proposés
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions    Subscription[]
  watchHistory     WatchHistory[]
  bookmarks        Bookmark[]
  wishlist         WishlistItem[]
  pageViews        PageView[]
  playbackProgress PlaybackProgress[]
  notifications    Notification[]

  @@map("users")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  link      String?
  read      Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           SubscriptionStatus @default(ACTIVE)
  plan             SubscriptionPlan   @default(MONTHLY)
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments Payment[]

  @@index([userId])
  @@map("subscriptions")
}

/// Paiement d'un abonnement Premium — ne stocke AUCUNE coordonnée bancaire
/// (CDC §8.2 : seuls l'identifiant du prestataire et les montants).
model Payment {
  id            String        @id @default(cuid())
  subscriptionId String?
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId        String?
  provider      String        // "WAVE" | "CINETPAY" | "PAYDUNYA" | "STRIPE" | "MANUAL"
  providerRef   String        @unique // id de transaction côté prestataire — clé d'idempotence (§8.2)
  amount        Int           // montant en centimes/minor units
  currency      String        @default("XOF")
  status        PaymentStatus @default(PENDING)
  plan          SubscriptionPlan @default(MONTHLY)
  rawPayload    Json?         // payload brut du webhook (audit, jamais de CB)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  events PaymentEvent[]

  @@index([userId])
  @@index([status])
  @@map("payments")
}

/// Journal brut des événements reçus du prestataire (CDC §13 payment_events).
/// `eventRef` unique → rejouer le même webhook est sans effet (idempotence §8.2).
model PaymentEvent {
  id         String   @id @default(cuid())
  paymentId  String?
  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider   String
  eventType  String   // ex. "payment.succeeded", "charge.completed"
  eventRef   String   @unique // identifiant d'événement côté prestataire
  processed  Boolean  @default(false)
  rawPayload Json?
  createdAt  DateTime @default(now())

  @@index([provider, eventType])
  @@map("payment_events")
}

model Category {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  description String?
  medias      MediaCategory[]

  @@map("categories")
}

model Media {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  synopsis         String          @db.Text
  type             MediaType       @default(MOVIE)
  accessLevel      AccessLevel     @default(FREE)
  releaseYear      Int
  durationMinutes  Int?
  posterUrl        String?
  backdropUrl      String?
  videoUrl         String?         // URL de lecture directe (fichier vidéo ou playlist HLS)
  isPublished      Boolean         @default(false)
  rightsValidUntil DateTime?       // Limite légale d'exploitation des droits
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  categories       MediaCategory[]
  seasons          Season[]
  watchHistory     WatchHistory[]

  @@index([slug])
  @@index([type, accessLevel, isPublished])
  @@map("medias")
}

model MediaCategory {
  mediaId    String
  categoryId String
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([mediaId, categoryId])
  @@map("media_categories")
}

model Season {
  id           String    @id @default(cuid())
  mediaId      String
  media        Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  seasonNumber Int
  title        String?
  episodes     Episode[]

  @@unique([mediaId, seasonNumber])
  @@map("seasons")
}

model Episode {
  id              String         @id @default(cuid())
  seasonId        String
  season          Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeNumber   Int
  title           String
  synopsis        String?        @db.Text
  durationMinutes Int?
  videoUrl        String?        // URL de lecture directe de l'épisode (fichier ou playlist HLS)
  accessLevel     AccessLevel    @default(FREE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  watchHistory    WatchHistory[]

  @@unique([seasonId, episodeNumber])
  @@map("episodes")
}

model WatchHistory {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId         String
  media           Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episodeId       String?
  episode         Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  progressSeconds Int       @default(0)
  totalSeconds    Int       @default(0)
  completed       Boolean   @default(false)
  updatedAt       DateTime  @updatedAt

  @@unique([userId, mediaId, episodeId])
  @@index([userId])
  @@map("watch_histories")
}

/// Position de lecture d'un titre du catalogue (local ou partenaire).
/// Comme Bookmark, `mediaSlug` est libre (pas de FK vers Media) afin de
/// couvrir les fiches externes : `partner-series-…`, `tmdb-movie-…`, etc.
/// `episodeKey` vaut "" pour un film, sinon "s{season}e{episode}".
model PlaybackProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaSlug       String
  episodeKey      String   @default("")
  seasonNumber    Int?
  episodeNumber   Int?
  progressSeconds Int      @default(0)
  totalSeconds    Int      @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@unique([userId, mediaSlug, episodeKey])
  @@index([userId])
  @@map("playback_progress")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Slug du titre : Media.slug local OU identifiant externe
  /// (`frenchstream-movie-…`, `frenchstream-series-…`, `frenchmanga-anime-…`).
  /// Pas de FK vers Media pour ne pas exclure le catalogue partenaire.
  mediaSlug String
  createdAt DateTime @default(now())

  @@unique([userId, mediaSlug])
  @@index([userId])
  @@map("bookmarks")
}

/// Liste de souhaits d'un utilisateur — même logique que Bookmark :
/// slug libre (local ou partenaire externe), sans FK vers Media.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaSlug String
  createdAt DateTime @default(now())

  @@unique([userId, mediaSlug])
  @@index([userId])
  @@map("wishlist_items")
}

/// Visite de page — trafic du site pour le dashboard admin.
/// Une ligne par page vue (anonyme par défaut, reliée à l'utilisateur si
/// connecté). Aucune donnée personnelle : chemin + horodatage suffisent
/// pour les visiteurs mensuels et les courbes de trafic.
model PageView {
  id        String   @id @default(cuid())
  path      String   @db.VarChar(512)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@map("page_views")
}

/* ------------------------------------------------------------------ */
/* Catalogue externe (CDC §13 : content_providers / provider_assets)   */
/*                                                                     */
/* Les assets externes ne sont JAMAIS mélangés à Media : clé           */
/* (provider, externalId, contentType) — l'identifiant CinéMax reste   */
/* indépendant de l'identifiant TMDB/IMDb (§4.6).                     */
/* ------------------------------------------------------------------ */

enum ProviderContentType {
  MOVIE
  SERIES
  ANIME
}

enum ProviderSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// Un titre du catalogue d'un fournisseur externe (métadonnées seulement).
model ProviderAsset {
  id            String               @id @default(cuid())
  provider                          String // "PARTNER" — générique pour tout futur fournisseur
  externalId                        String // TMDB/IMDb ; nom pour les animés (pas d'id exposé)
  contentType   ProviderContentType
  title                             String
  releaseYear   Int?
  posterUrl                           String?
  totalEpisodes Int?                 // animés uniquement
  /// Forme de lecture réelle chez le fournisseur : "movie" ou "tv".
  /// Indispensable pour les animés (un même catalogue mélange films et séries)
  /// et pour router vers le bon lecteur (/films vs /series).
  sourceType    String?
  /// Slug de catégorie / genre pour le filtrage (ex: action, aventure, horreur…).
  categorySlug  String?
  /// Langue de diffusion (ex: VF, VOSTFR, VO).
  language      String?
  /// Thème / ambiance (ex: comédie, drame, action, sf…).
  theme         String?
  /// Plateformes de diffusion (slugs encadrés par des virgules, ex :
  /// ",netflix,disney,"). Alimente le filtre « Plateforme » du catalogue.
  /// Écrit par la synchro des plateformes (modules/providers/tmdb/platform.sync).
  platforms     String?
  /// Rang dans l'ordre « popular » du fournisseur (1 = plus tendance). Alimente la
  /// section « À la une ». Rafraîchi à chaque synchro de l'ordre popular.
  trendingRank  Int?
  /// Publication contrôlée par l'admin : un asset masqué (isPublished=false)
  /// disparaît des grilles, de la recherche et de la une, mais reste en base.
  /// La synchro ne l'écrase jamais (l'admin reste maître de la mise en ligne).
  /// Par défaut, un asset importé est publié (comportement historique).
  isPublished   Boolean            @default(true)
  /// Doublon d'un titre d'un fournisseur prioritaire (ex. un titre FRENCHSTREAM
  /// déjà présent dans le catalogue TMDB). Masqué des grilles/recherche sans
  /// toucher au choix de publication de l'admin (`isPublished`). Calculé par la
  /// déduplication (voir modules/providers/tmdb/dedupe.ts).
  isDuplicate   Boolean            @default(false)
  /// Vrai si au moins une source de lecture est connue pour ce titre (Vidzy
  /// ou un fournisseur de repli homologue). Calculé par la passe de couverture
  /// (scripts/coverage-fstreamtv.ts). Les grilles ne listent que hasSources=true
  /// pour ne pas exposer de fiches sans lecteur.
  hasSources    Boolean            @default(true)
  firstSeenAt   DateTime             @default(now())
  lastSeenAt    DateTime             @default(now()) // rafraîchi à chaque synchro

  @@unique([provider, externalId, contentType])
  @@index([provider, contentType, lastSeenAt])
  @@index([provider, contentType, trendingRank])
  @@index([provider, isPublished])
  @@index([provider, contentType, categorySlug])
  @@index([provider, contentType, platforms])
  @@index([provider, contentType, releaseYear])
  @@index([provider, contentType, isDuplicate])
  @@index([provider, contentType, hasSources])
  @@map("provider_assets")
}

/// Journal d'une synchro incrémentale (audit, reprise après incident §15).
model ProviderSyncRun {
  id             String             @id @default(cuid())
  provider       String
  status         ProviderSyncStatus @default(RUNNING)
  pagesFetched   Int                @default(0)
  assetsUpserted Int                @default(0)
  assetsPruned   Int                @default(0)
  error          String?            @db.Text
  startedAt      DateTime           @default(now())
  finishedAt     DateTime?

  @@index([provider, startedAt])
  @@map("provider_sync_runs")
}
